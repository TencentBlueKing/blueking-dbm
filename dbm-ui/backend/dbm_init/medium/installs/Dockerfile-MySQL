## busybox 自带的 wget 与 GitHub 的 TLS 握手不稳定，改用 curl 下载介质
FROM curlimages/curl:8.11.1 AS downloader
USER root

ARG DOWNLOAD_URL=https://github.com/TencentBlueKing/blueking-dbm/releases/download
ARG VERSION=v1.0.0

## 获取二进制介质，将静态介质存放到/data目录
RUN set -ex && \
    mkdir /data && cd /data && \
    for f in \
        dbm_mysqld_exporter.tgz \
        dbm_mysqlproxy_exporter.tgz \
        dbm_tbinlogdumper_exporter.tgz \
        mysql-8.0.32-linux-glibc2.12-x86_64.tar.xz \
        mysql-proxy-0.82.20.tar.gz \
        mariadb-10.3.7-linux-x86_64-tspider-3.7.12-gcs.tar.gz \
        mysql-5.7.20-linux-x86_64-tdbctl-2.4.13.tar.gz \
    ; do \
        curl -fsSL -k --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 30 \
            -o "$f" "${DOWNLOAD_URL}/${VERSION}/$f"; \
    done

## busybox，集合了常用的linux工具箱
FROM busybox:latest
COPY --from=downloader /data /data

## 将install的文件移动到/mysql-install，这样通过挂载/mysql-install可以共享文件
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /install/mysql && mv /data/* /install/mysql/"]

## busybox 自带的 wget 与 GitHub 的 TLS 握手不稳定，改用 curl 下载介质
FROM curlimages/curl:8.11.1 AS downloader
USER root

ARG DOWNLOAD_URL=https://github.com/TencentBlueKing/blueking-dbm/releases/download
ARG VERSION=v1.0.0

## 获取二进制介质，将静态介质存放到/data目录
RUN set -ex && \
    mkdir /data && cd /data && \
    for f in \
        espack-7.10.2.tar.gz \
        analysis-icu-7.10.2.tar.gz \
        analysis-ik-7.10.2.tar.gz \
        analysis-pinyin-7.10.2.tar.gz \
        opendistro_security-1.13.1.0.tar.gz \
        opendistro-alerting-1.13.1.0.tar.gz \
        opendistro-job-scheduler-1.13.0.0.tar.gz \
        opendistro-knn-1.12.0.0.tar.gz \
        opendistro-sql-1.13.2.0.tar.gz \
        repository-cos-7.10.2.tar.gz \
        repository-hdfs-7.10.2.tar.gz \
        dbm_elasticsearch_exporter.tgz \
    ; do \
        curl -fsSL -k --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 30 \
            -o "$f" "${DOWNLOAD_URL}/${VERSION}/$f"; \
    done

## busybox，集合了常用的linux工具箱
FROM busybox:latest
COPY --from=downloader /data /data

## 将install的文件移动到/install/xxx，这样通过挂载/install可以共享文件
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /install/es && mv /data/* /install/es/"]

## busybox 自带的 wget 与 GitHub 的 TLS 握手不稳定，改用 curl 下载介质
FROM curlimages/curl:8.11.1 AS downloader
USER root

ARG DOWNLOAD_URL=https://github.com/TencentBlueKing/blueking-dbm/releases/download
ARG VERSION=v1.0.0

## 获取二进制介质，将静态介质存放到/data目录
RUN set -ex && \
    mkdir /data && cd /data && \
    for f in \
        dbm_predixy_exporter.tgz \
        dbm_redis_exporter.tgz \
        predixy-1.6.2.tar.gz \
        redis-6.2.21.tar.gz \
        tendisplus-2.8.2-rocksdb-v8.5.3.tgz \
        twemproxy-0.4.1-v36.tar.gz \
    ; do \
        curl -fsSL -k --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 30 \
            -o "$f" "${DOWNLOAD_URL}/${VERSION}/$f"; \
    done

## busybox，集合了常用的linux工具箱
FROM busybox:latest
COPY --from=downloader /data /data

## 将install的文件移动到/install/xxx，这样通过挂载/install可以共享文件
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /install/redis && mv /data/* /install/redis/"]

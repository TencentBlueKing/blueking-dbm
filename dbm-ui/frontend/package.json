{
  "name": "bk-dbm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-https": "vite --mode https",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=128' run-p build-only",
    "preview": "vite preview",
    "prepare": "npx simple-git-hooks",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:lint-staged": "lint-staged",
    "lint:script": "eslint ./src/views/ticket-center/common/ticket-detail --fix",
    "lint:style": "stylelint --fix ./src/**/*.{vue,css,less} --custom-syntax",
    "lint": "run-s lint:*",
    "prettier": "prettier --write ./src",
    "e2e-dev": "npx cypress open",
    "e2e": "npx cypress run --browser chrome --headless",
    "e2e-parallel": "cypress-parallel -s e2e -t 8 -d cypress/e2e",
    "component-test": "npx cypress run --component --browser chrome",
    "test": "start-server-and-test dev http://127.0.0.1:8088 e2e-parallel"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@blueking/ai-blueking": "2.2.1-beta.2",
    "@blueking/app-select": "0.0.1-beta.19",
    "@blueking/bk-trace-core": "0.0.6",
    "@blueking/bk-user-selector": "0.1.12",
    "@blueking/date-picker": "1.0.1",
    "@blueking/ip-selector": "0.3.0-beta.23",
    "@blueking/login-modal": "1.0.6",
    "@blueking/login-userinfo": "0.0.16",
    "@blueking/notice-component": "2.0.8",
    "@blueking/sub-saas": "0.0.0-beta.6",
    "@blueking/table": "0.0.1-beta.39",
    "@blueking/tdesign-ui": "0.0.4-beta.3",
    "@blueking/xss-filter": "0.0.10",
    "@icon-cool/bk-icon-bk-biz-components": "0.0.4",
    "@vueuse/core": "14.3.0",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "axios": "1.18.1",
    "bkui-vue": "2.1.0-beta.11",
    "date-fns": "4.4.0",
    "dayjs": "1.11.21",
    "dompurify": "3.4.12",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "html-to-image": "1.11.13",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.5.4",
    "lodash": "4.18.1",
    "markdown-it": "14.3.0",
    "mitt": "3.0.1",
    "monaco-editor": "0.55.1",
    "monaco-promql": "1.9.0",
    "npm-check": "6.0.1",
    "pinia": "3.0.4",
    "qs": "6.15.3",
    "screenfull": "6.0.2",
    "sql-formatter": "15.8.2",
    "tiny-pinyin": "1.3.2",
    "tippy.js": "6.3.7",
    "url-join": "5.0.0",
    "vue": "3.5.39",
    "vue-content-loader": "2.0.1",
    "vue-i18n": "11.4.6",
    "vue-request": "2.0.4",
    "vue-router": "5.1.0",
    "vue-types": "7.0.0",
    "vuedraggable": "4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.0",
    "@prettier/plugin-oxc": "0.2.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@tsconfig/node22": "22.0.5",
    "@types/lodash": "4.17.24",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.1.1",
    "@types/qs": "6.15.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "commitlint": "21.2.1",
    "cross-env": "10.1.0",
    "cypress": "15.18.1",
    "cypress-multi-reporters": "2.0.5",
    "cypress-parallel": "0.15.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-tencent": "1.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-oxlint": "1.73.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "less": "4.6.7",
    "lint-staged": "17.0.8",
    "npm-run-all2": "9.0.2",
    "oxlint": "1.74.0",
    "postcss-html": "1.8.1",
    "postcss-less": "6.0.0",
    "prettier": "3.9.5",
    "simple-git-hooks": "2.13.1",
    "start-server-and-test": "3.0.11",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-less": "4.2.1",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.1.4",
    "vite-plugin-babel": "1.7.3",
    "vite-plugin-imp": "2.4.0",
    "vite-plugin-monaco-editor": "1.1.0",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-style-import": "2.0.0",
    "vue-component-type-helpers": "3.3.7",
    "vue-tsc": "3.3.7"
  },
  "simple-git-hooks": {
    "pre-commit": "cd dbm-ui/frontend && npx lint-staged",
    "commit-msg": "cd dbm-ui/frontend && npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.css": "stylelint --allow-empty-input",
    "*.less": "stylelint --allow-empty-input --fix --customSyntax=postcss-less",
    "*.{js,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.16.0"
  }
}

# Copy to dbha-v2.server.rc and adjust. Used to render server-side configs
# (admin/analysis/receiver). Run with:
#   render_configs.py --module server --rc etc/dbha-v2.server.rc \
#       --ip-detect-udp-connect-host HOST
# All template placeholders must be set here; the renderer only injects
# defaults for ADMIN_/RECEIVER_/ANALYSIS_APM_LISTEN_ADDRESS /
# RECEIVER_SOURCE_PROBE_ENDPOINT / ADMIN_GRPC_LISTEN_ADDRESS /
# ADMIN_WEB_LISTEN_ADDRESS when empty.
# Syntax: KEY=value or KEY="value with spaces"; use \n \" \\ inside double quotes.
#
# Endpoint / listen address format (applies to every *_LISTEN_ADDRESS and
# *_ENDPOINT key in this file): each value accepts one of:
#   - host:port              (e.g. 127.0.0.1:50080)
#   - tcp://host:port        (e.g. tcp://127.0.0.1:3306)
#   - http://host:port       (e.g. http://127.0.0.1:50080)
# When the scheme is omitted, each consumer applies its own default scheme:
#   - admin/receiver/analysis APM listen, admin web listen, etcd discovery,
#     bkMonitor endpoint -> http
#   - admin gRPC listen, receiver probe source listen, MySQL storage / sink,
#     kafka source -> tcp
# The scheme is informational; the actual transport is decided by the consumer.
# Note: discovery endpoint (COMMON_DISCOVERY_ENDPOINT) only accepts host:port,
# http://host:port, or https://host:port. Do not use tcp:// for discovery.

# --- shared (admin + analysis + receiver) ---
COMMON_VERSION=v2.0.0
COMMON_LOG_LEVEL=debug
COMMON_LOG_FILE_COUNT=10
COMMON_LOG_FILE_SIZE=100

COMMON_DISCOVERY_ENDPOINT=""
COMMON_DISCOVERY_USER=root
COMMON_DISCOVERY_PASSWORD=dbhatest
COMMON_DISCOVERY_TLS_CERT_FILE=""
COMMON_DISCOVERY_TLS_KEY_FILE=""
COMMON_DISCOVERY_TLS_TRUSTED_CA_FILE=""

# apm timeouts shared by all server services; per-service listen addresses
# are configured in their own sections below (ADMIN_/RECEIVER_/ANALYSIS_APM_LISTEN_ADDRESS).
# Leave any per-service listen address empty to fall back to
# http://<auto-detected-ipv4>:50080|50081|50082 at render time.
COMMON_APM_READ_TIMEOUT=10s
COMMON_APM_WRITE_TIMEOUT=10s

# dbm HTTP APIs shared by admin and analysis
COMMON_DBM_API_HTTP_METHOD=post
COMMON_DBM_API_TIMEOUT=10s
COMMON_DBM_API_METADATA_API=""
COMMON_DBM_API_METADATA_TOKEN=""
COMMON_DBM_API_UPDATE_STATUS_API=""
COMMON_DBM_API_UPDATE_STATUS_TOKEN=""
COMMON_DBM_API_SWAP_MYSQL_ROLE_API=""
COMMON_DBM_API_SWAP_MYSQL_ROLE_TOKEN=""
COMMON_DBM_API_SWAP_TENDIS_CLUSTER_API=""
COMMON_DBM_API_SWAP_TENDIS_CLUSTER_TOKEN=""
COMMON_DBM_API_DOMAIN_GET_API=""
COMMON_DBM_API_DOMAIN_GET_TOKEN=""
COMMON_DBM_API_DOMAIN_DELETE_API=""
COMMON_DBM_API_DOMAIN_DELETE_TOKEN=""
COMMON_DBM_API_CLB_DEREGISTER_API=""
COMMON_DBM_API_CLB_DEREGISTER_TOKEN=""
COMMON_DBM_API_POLARIS_UNBIND_API=""
COMMON_DBM_API_POLARIS_UNBIND_TOKEN=""
COMMON_DBM_API_DUMPER_SWITCH_API=""
COMMON_DBM_API_DUMPER_SWITCH_TOKEN=""

# DBHA v1 API (workflow.dbhav1ApiBlackWhitelistGet)
COMMON_DBHAV1_API_TIMEOUT=10s
COMMON_DBHAV1_API_BLACK_WHITELIST_GET_API=""
COMMON_DBHAV1_API_BLACK_WHITELIST_GET_TOKEN=""

# storage tcp endpoint/user/password/timeout shared by admin, analysis,
# and receiver sink mysql
COMMON_STORAGE_TCP_ENDPOINT=""
COMMON_STORAGE_USER=root
COMMON_STORAGE_PASSWORD=dbhatest
COMMON_STORAGE_TIMEOUT=10s

# --- receiver ---

# ## receiver · process and identity
RECEIVER_NAME=receiver
RECEIVER_PID_FILE=./pids/receiver.pid

# ## receiver · discovery (runtime tuning)
RECEIVER_DISCOVERY_SERVICE_TIMER_INTERVAL=3s
RECEIVER_DISCOVERY_SERVICE_UPDATE_TIMEOUT=3s

# ## receiver · apm
# omit RECEIVER_APM_LISTEN_ADDRESS or leave empty to use
# http://<auto-detected-ipv4>:50081 at render time
RECEIVER_APM_LISTEN_ADDRESS=http://127.0.0.1:50081

# ## receiver · shard templates
# shard files (paths relative to this rc)
RECEIVER_SOURCE_PROBE_SHARD_FILE=templates/snippets/receiver_source_probe.yaml
RECEIVER_SOURCE_KAFKA_SHARD_FILE=templates/snippets/receiver_source_kafka.yaml
RECEIVER_SINK_MYSQL_SHARD_FILE=templates/snippets/receiver_sink_mysql.yaml

# ## receiver · service.source · probe
RECEIVER_SOURCE_PROBE_NAME=probe
RECEIVER_SOURCE_PROBE_ENABLE=false
# omit RECEIVER_SOURCE_PROBE_ENDPOINT or leave empty to use
# <auto-detected-ipv4>:50052 at render time
RECEIVER_SOURCE_PROBE_ENDPOINT=""
RECEIVER_SOURCE_PROBE_NET_DIAL_TIMEOUT=30s
RECEIVER_SOURCE_PROBE_NET_READ_TIMEOUT=30s
RECEIVER_SOURCE_PROBE_NET_WRITE_TIMEOUT=30s
RECEIVER_SOURCE_PROBE_USER=""
RECEIVER_SOURCE_PROBE_PASSWORD=""
RECEIVER_SOURCE_PROBE_MECHANISM=plaintext
RECEIVER_SOURCE_PROBE_TOPICS=[]
RECEIVER_SOURCE_PROBE_BUFFER_SIZE=1024
RECEIVER_SOURCE_PROBE_GRPC_SERVER_PING_TIME=5m
RECEIVER_SOURCE_PROBE_GRPC_PING_TIMEOUT=10s
RECEIVER_SOURCE_PROBE_GRPC_KEEP_ALIVE_MIN_TIME=5m
RECEIVER_SOURCE_PROBE_GRPC_MAX_RECEIVE_MESSAGE_SIZE=10485760
RECEIVER_SOURCE_PROBE_GRPC_MAX_SEND_MESSAGE_SIZE=10485760

# ## receiver · service.source · kafka
RECEIVER_SOURCE_KAFKA_NAME=kafka
RECEIVER_SOURCE_KAFKA_ENABLE=true
RECEIVER_SOURCE_KAFKA_ENDPOINT=""
RECEIVER_SOURCE_KAFKA_USER=root
RECEIVER_SOURCE_KAFKA_PASSWORD=1234567890
RECEIVER_SOURCE_KAFKA_NET_DIAL_TIMEOUT=30s
RECEIVER_SOURCE_KAFKA_NET_READ_TIMEOUT=30s
RECEIVER_SOURCE_KAFKA_NET_WRITE_TIMEOUT=30s
RECEIVER_SOURCE_KAFKA_MECHANISM=plaintext
RECEIVER_SOURCE_KAFKA_TOPICS=[test]

# ## receiver · service.sink · mysql
RECEIVER_SINK_MYSQL_NAME=mysql
RECEIVER_SINK_MYSQL_ENABLE=true
RECEIVER_SINK_MYSQL_SAVE_TIMEOUT=10s

# ## receiver · logging
RECEIVER_LOG_PATH=./logs/receiver.log

# --- admin ---

# ## admin · process and identity
ADMIN_NAME=admin
ADMIN_PID_FILE=./pids/admin.pid
ADMIN_DOC_FILE_DIR=./docs

# ## admin · discovery (runtime tuning)
ADMIN_DISCOVERY_SERVICE_TIMER_INTERVAL=3s
ADMIN_DISCOVERY_SERVICE_UPDATE_TIMEOUT=3s

# ## admin · apm
# omit ADMIN_APM_LISTEN_ADDRESS or leave empty to use
# http://<auto-detected-ipv4>:50080 at render time
ADMIN_APM_LISTEN_ADDRESS=http://127.0.0.1:50080

# ## admin · grpc
# omit ADMIN_GRPC_LISTEN_ADDRESS or use :<port> only to fill host via same
# IP detection as APM/probe
ADMIN_GRPC_LISTEN_ADDRESS=127.0.0.1:50051
ADMIN_GRPC_SERVER_PING_TIME=5m
ADMIN_GRPC_PING_TIMEOUT=10s
ADMIN_GRPC_KEEP_ALIVE_MIN_TIME=5m
ADMIN_GRPC_PERMIT_WITHOUT_STREAM=true
ADMIN_GRPC_MAX_RECEIVE_MESSAGE_SIZE=10485760
ADMIN_GRPC_MAX_SEND_MESSAGE_SIZE=10485760

# ## admin · web
# omit ADMIN_WEB_LISTEN_ADDRESS or leave empty to use
# http://<auto-detected-ipv4>:50060 at render time
ADMIN_WEB_LISTEN_ADDRESS=""
ADMIN_WEB_READ_TIMEOUT=5s
ADMIN_WEB_WRITE_TIMEOUT=5s

# ## admin · logging
ADMIN_LOG_PATH=./logs/admin.log

# ## admin · probe gse reporter defaults (returned to probe via GetProbeConfig)
ADMIN_PROBE_GSE_ENDPOINT=""
ADMIN_PROBE_GSE_DATA_ID=0
ADMIN_PROBE_GSE_LOCAL_SOCKET_PORT=0
ADMIN_PROBE_GSE_CONN_TIMEOUT=5s

# ## admin · probe harvester defaults (returned to every probe; probe routes per endpoint)
# probe routes credentials per endpoint based on (access_layer, machine_type):
#   - probeProxyAdmin: access_layer==proxy AND machine_type==proxy (TendbHA mysql-proxy admin port).
#   - probeMysql:      other mysql-family endpoints (incl. spider admin/ctl).
#   - probeRedis:      redis-family endpoints (incl. twemproxy/predixy admin ports).
# interval/timeout: zero or below the minimum is auto-clamped at admin load
# (interval minimum: 5s, timeout minimum: 1s). The value MUST be a valid Go duration
# (e.g. 20s, 1m); empty values make admin config Load fail before clamping.
# heartbeatInterval minimum: 1s; replDelayInterval minimum: 5s.
ADMIN_PROBE_MYSQL_USER=""
ADMIN_PROBE_MYSQL_PASSWORD=""
ADMIN_PROBE_MYSQL_INTERVAL=20s
ADMIN_PROBE_MYSQL_HEARTBEAT_INTERVAL=3s
ADMIN_PROBE_MYSQL_REPL_DELAY_INTERVAL=20s
ADMIN_PROBE_MYSQL_TIMEOUT=5s

ADMIN_PROBE_REDIS_USER=""
ADMIN_PROBE_REDIS_PASSWORD=""
ADMIN_PROBE_REDIS_INTERVAL=20s
ADMIN_PROBE_REDIS_TIMEOUT=5s

ADMIN_PROBE_PROXY_ADMIN_USER=""
ADMIN_PROBE_PROXY_ADMIN_PASSWORD=""
ADMIN_PROBE_PROXY_ADMIN_INTERVAL=20s
ADMIN_PROBE_PROXY_ADMIN_HEARTBEAT_INTERVAL=3s
ADMIN_PROBE_PROXY_ADMIN_REPL_DELAY_INTERVAL=20s
ADMIN_PROBE_PROXY_ADMIN_TIMEOUT=5s

# --- analysis ---

# ## analysis · process and identity
ANALYSIS_NAME=analysis
ANALYSIS_PID_FILE=./pids/analysis.pid

# ## analysis · discovery (runtime tuning)
ANALYSIS_DISCOVERY_SERVICE_TIMER_INTERVAL=3s
ANALYSIS_DISCOVERY_SERVICE_UPDATE_TIMEOUT=3s

# ## analysis · apm
# omit ANALYSIS_APM_LISTEN_ADDRESS or leave empty to use
# http://<auto-detected-ipv4>:50082 at render time
ANALYSIS_APM_LISTEN_ADDRESS=http://127.0.0.1:50082

# ## analysis · workflow
ANALYSIS_WORKFLOW_WORKER_BUSINESS_COUNT=100
ANALYSIS_WORKFLOW_LOCK_BUSINESS_WAIT_TIMEOUT=5s
ANALYSIS_WORKFLOW_SCAN_TIMEOUT=60s
ANALYSIS_WORKFLOW_SCAN_INTERVAL=3s
ANALYSIS_WORKFLOW_UPDATE_DBM_CACHE_INTERVAL=10s
ANALYSIS_WORKFLOW_READ_DB_META_OFFSET_DURATION=-24h
ANALYSIS_WORKFLOW_READ_DB_METRIC_OFFSET_DURATION=-60s
ANALYSIS_WORKFLOW_READ_DB_EVENT_OFFSET_DURATION=-10m
ANALYSIS_WORKFLOW_ENABLE_SWITCHING=true
ANALYSIS_WORKFLOW_ENABLE_WHITE_LIST=true
ANALYSIS_WORKFLOW_POP_INTERVAL=5s
ANALYSIS_WORKFLOW_POP_SWITCH_SEM_SIZE=10
ANALYSIS_WORKFLOW_WINDOW_DURATION=10s
ANALYSIS_WORKFLOW_INFLIGHT_TTL=30s
ANALYSIS_WORKFLOW_SWITCH_TIMEOUT=10m
ANALYSIS_WORKFLOW_DBM_API_METADATA_HASH_CNT=200
ANALYSIS_WORKFLOW_DBM_API_MAX_CONCURRENT_REQUESTS=8
ANALYSIS_WORKFLOW_HOST_LEVEL_SWITCH_MAX_HOST_NUM=32
ANALYSIS_WORKFLOW_HOST_LEVEL_SWITCH_MAX_INSTANCE_NUM=64
ANALYSIS_WORKFLOW_CLUSTER_LEVEL_SWITCH_MAX_CLUSTER_NUM=32
ANALYSIS_WORKFLOW_CLUSTER_LEVEL_SWITCH_MAX_INSTANCE_NUM=64
ANALYSIS_WORKFLOW_SWITCHFLOW_SWITCH_LOG_WRITE_TIMEOUT=1s
ANALYSIS_WORKFLOW_SWITCHFLOW_DB_CONNECT_TIMEOUT=3s
ANALYSIS_WORKFLOW_SWITCHFLOW_CLUSTER_LOCK_TIMEOUT=60s
ANALYSIS_WORKFLOW_SWITCHFLOW_EXEC_SQL_TIMEOUT=6s
ANALYSIS_WORKFLOW_SWITCHFLOW_SLAVE_ALLOWED_IGNORE_CHECK_SUM=false
ANALYSIS_WORKFLOW_SWITCHFLOW_SLAVE_ALLOWED_IGNORE_SLAVE_DELAY=false
ANALYSIS_WORKFLOW_SWITCHFLOW_SLAVE_ALLOWED_SLOW_BYTES=0
ANALYSIS_WORKFLOW_SWITCHFLOW_SLAVE_ALLOWED_MAX_CHECKSUM_FAIL_CNT=2
ANALYSIS_WORKFLOW_SWITCHFLOW_SLAVE_ALLOWED_MAX_HEARTBEAT_DELAY=600
# ## analysis · database (mysql control)
ANALYSIS_DATABASE_MYSQL_CTRL_USER=mysql
ANALYSIS_DATABASE_MYSQL_CTRL_PASSWORD=xxx
ANALYSIS_DATABASE_MYSQL_CTRL_DELEGATE_USER=proxy
ANALYSIS_DATABASE_MYSQL_CTRL_DELEGATE_PASSWORD=xxx
ANALYSIS_DATABASE_MYSQL_CTRL_TIMEOUT=10s

# ## analysis · detector (ssh)
# probe install root on probe nodes; must match deploy.sh -t target directory
PROBE_INSTALL_DIR=/usr/local/dbha-v2
# remote SSH command for probe liveness double-check; must match probe binary path on target hosts
ANALYSIS_DETECTOR_CHECK_PROBE_PROCESS_CMD="cd /usr/local/dbha-v2 && ./bin/dbha-probe health -j"
ANALYSIS_DETECTOR_SSH_PORT=22
ANALYSIS_DETECTOR_SSH_USER=root
ANALYSIS_DETECTOR_SSH_PASSWORD=123456789
ANALYSIS_DETECTOR_SSH_TIMEOUT=10s

# ## analysis · monitor
ANALYSIS_MONITOR_DATA_ID=0
ANALYSIS_MONITOR_TIMEOUT=10s
ANALYSIS_MONITOR_ACCESS_TOKEN=""
ANALYSIS_MONITOR_BK_MONITOR_BEAT=""
ANALYSIS_MONITOR_BK_MONITOR_ENDPOINT=127.0.0.1:9090

# ## analysis · logging
ANALYSIS_LOG_PATH=./logs/analysis.log

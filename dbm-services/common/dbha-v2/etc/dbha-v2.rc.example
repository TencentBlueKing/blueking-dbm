# Copy to dbha-v2.rc and adjust. All template placeholders must be set here;
# scripts/render_configs.py does not inject defaults (run it with required
# --ip-detect-udp-connect-host HOST when using auto IPv4 for empty APM/probe/admin listen keys).
# Syntax: KEY=value or KEY="value with spaces"; use \n \" \\ inside double quotes.

# --- shared (receiver + analysis + admin where applicable) ---
COMMON_VERSION=v2.0.0
COMMON_LOG_LEVEL=debug
COMMON_LOG_FILE_COUNT=10
COMMON_LOG_FILE_SIZE=100

COMMON_DISCOVERY_ENDPOINT=""
COMMON_DISCOVERY_USER=root
COMMON_DISCOVERY_PASSWORD=dbhatest
COMMON_DISCOVERY_TLS_CERT_FILE=""
COMMON_DISCOVERY_TLS_KEY_FILE=""
COMMON_DISCOVERY_TLS_TRUSTED_CA_FILE=""

# apm settings shared by all services; omit COMMON_APM_LISTEN_ADDRESS or leave empty
# to use http://<auto-detected-ipv4>:50050 at render time
COMMON_APM_LISTEN_ADDRESS=""
COMMON_APM_READ_TIMEOUT=10s
COMMON_APM_WRITE_TIMEOUT=10s

# dbm HTTP APIs shared by admin and analysis
COMMON_DBM_API_HTTP_METHOD=post
COMMON_DBM_API_TIMEOUT=10s
COMMON_DBM_API_METADATA_API=""
COMMON_DBM_API_METADATA_TOKEN=""
COMMON_DBM_API_UPDATE_STATUS_API=""
COMMON_DBM_API_UPDATE_STATUS_TOKEN=""
COMMON_DBM_API_SWAP_MYSQL_ROLE_API=""
COMMON_DBM_API_SWAP_MYSQL_ROLE_TOKEN=""
COMMON_DBM_API_SWAP_TENDIS_CLUSTER_API=""
COMMON_DBM_API_SWAP_TENDIS_CLUSTER_TOKEN=""
COMMON_DBM_API_DOMAIN_GET_API=""
COMMON_DBM_API_DOMAIN_GET_TOKEN=""
COMMON_DBM_API_DOMAIN_DELETE_API=""
COMMON_DBM_API_DOMAIN_DELETE_TOKEN=""
COMMON_DBM_API_CLB_DEREGISTER_API=""
COMMON_DBM_API_CLB_DEREGISTER_TOKEN=""
COMMON_DBM_API_POLARIS_UNBIND_API=""
COMMON_DBM_API_POLARIS_UNBIND_TOKEN=""
COMMON_DBM_API_DUMPER_SWITCH_API=""
COMMON_DBM_API_DUMPER_SWITCH_TOKEN=""

# storage tcp endpoint/user/password/timeout shared by admin, analysis, and receiver sink mysql
COMMON_STORAGE_TCP_ENDPOINT=""
COMMON_STORAGE_USER=root
COMMON_STORAGE_PASSWORD=dbhatest
COMMON_STORAGE_TIMEOUT=10s

# --- receiver ---

# ## receiver · process and identity
RECEIVER_NAME=receiver
RECEIVER_PID_FILE=./pids/receiver.pid

# ## receiver · shard templates
# shard files (paths relative to this rc)
RECEIVER_SOURCE_PROBE_SHARD_FILE=templates/snippets/receiver_source_probe.yaml
RECEIVER_SOURCE_KAFKA_SHARD_FILE=templates/snippets/receiver_source_kafka.yaml
RECEIVER_SINK_MYSQL_SHARD_FILE=templates/snippets/receiver_sink_mysql.yaml

# ## receiver · service.source · probe
RECEIVER_SOURCE_PROBE_NAME=probe
RECEIVER_SOURCE_PROBE_ENABLE=false
# omit RECEIVER_SOURCE_PROBE_ENDPOINT or leave empty to use <auto-detected-ipv4>:50051 at render time
RECEIVER_SOURCE_PROBE_ENDPOINT=""
RECEIVER_SOURCE_PROBE_NET_DIAL_TIMEOUT=30s
RECEIVER_SOURCE_PROBE_NET_READ_TIMEOUT=30s
RECEIVER_SOURCE_PROBE_NET_WRITE_TIMEOUT=30s
RECEIVER_SOURCE_PROBE_USER=""
RECEIVER_SOURCE_PROBE_PASSWORD=""
RECEIVER_SOURCE_PROBE_MECHANISM=plaintext
RECEIVER_SOURCE_PROBE_TOPICS=[]

# ## receiver · service.source · kafka
RECEIVER_SOURCE_KAFKA_NAME=kafka
RECEIVER_SOURCE_KAFKA_ENABLE=true
RECEIVER_SOURCE_KAFKA_ENDPOINT=""
RECEIVER_SOURCE_KAFKA_USER=root
RECEIVER_SOURCE_KAFKA_PASSWORD=1234567890
RECEIVER_SOURCE_KAFKA_NET_DIAL_TIMEOUT=30s
RECEIVER_SOURCE_KAFKA_NET_READ_TIMEOUT=30s
RECEIVER_SOURCE_KAFKA_NET_WRITE_TIMEOUT=30s
RECEIVER_SOURCE_KAFKA_MECHANISM=plaintext
RECEIVER_SOURCE_KAFKA_TOPICS=[test]

# ## receiver · service.sink · mysql
RECEIVER_SINK_MYSQL_NAME=mysql
RECEIVER_SINK_MYSQL_ENABLE=true

# ## receiver · logging
RECEIVER_LOG_PATH=./logs/receiver.log

# --- admin ---

# ## admin · process and identity
ADMIN_NAME=admin
ADMIN_PID_FILE=./pids/admin.pid
ADMIN_DOC_FILE_DIR=./docs

# ## admin · grpc
# omit ADMIN_GRPC_LISTEN_ADDRESS or use :<port> only to fill host via same IP detection as APM/probe
ADMIN_GRPC_LISTEN_ADDRESS=127.0.0.1:50051
ADMIN_GRPC_SERVER_PING_TIME=5m
ADMIN_GRPC_PING_TIMEOUT=10s
ADMIN_GRPC_KEEP_ALIVE_MIN_TIME=5m
ADMIN_GRPC_PERMIT_WITHOUT_STREAM=true
ADMIN_GRPC_MAX_RECEIVE_MESSAGE_SIZE=10485760
ADMIN_GRPC_MAX_SEND_MESSAGE_SIZE=10485760

# ## admin · web
ADMIN_WEB_HOST=""
ADMIN_WEB_PORT=50060
ADMIN_WEB_READ_TIMEOUT=5s
ADMIN_WEB_WRITE_TIMEOUT=5s

# ## admin · logging
ADMIN_LOG_PATH=./logs/admin.log

# ## admin · probe gse reporter defaults (returned to probe via GetProbeConfig)
ADMIN_PROBE_GSE_ENDPOINT=""
ADMIN_PROBE_GSE_DATA_ID=0
ADMIN_PROBE_GSE_CONN_TIMEOUT=5s

# --- analysis ---

# ## analysis · process and identity
ANALYSIS_NAME=analysis
ANALYSIS_PID_FILE=./pids/analysis.pid

# ## analysis · workflow
ANALYSIS_WORKFLOW_WORKER_BUSINESS_COUNT=100
ANALYSIS_WORKFLOW_LOCK_BUSINESS_WAIT_TIMEOUT=5s
ANALYSIS_WORKFLOW_SCAN_TIMEOUT=60s
ANALYSIS_WORKFLOW_SCAN_INTERVAL=3s
ANALYSIS_WORKFLOW_UPDATE_DBM_CACHE_INTERVAL=10s
ANALYSIS_WORKFLOW_READ_DB_META_OFFSET_DURATION=-24h
ANALYSIS_WORKFLOW_READ_DB_METRIC_OFFSET_DURATION=-60s
ANALYSIS_WORKFLOW_READ_DB_EVENT_OFFSET_DURATION=-10m
ANALYSIS_WORKFLOW_ENABLE_SWITCHING=true
ANALYSIS_WORKFLOW_POP_INTERVAL=5s
ANALYSIS_WORKFLOW_WINDOW_DURATION=10s
ANALYSIS_WORKFLOW_INFLIGHT_TTL=30s
ANALYSIS_WORKFLOW_SWITCH_TIMEOUT=1m

# ## analysis · database (mysql control)
ANALYSIS_DATABASE_MYSQL_CTRL_USER=mysql
ANALYSIS_DATABASE_MYSQL_CTRL_PASSWORD=xxx
ANALYSIS_DATABASE_MYSQL_CTRL_DELEGATE_USER=proxy
ANALYSIS_DATABASE_MYSQL_CTRL_DELEGATE_PASSWORD=xxx
ANALYSIS_DATABASE_MYSQL_CTRL_TIMEOUT=10s

# ## analysis · detector (ssh)
ANALYSIS_DETECTOR_SSH_PORT=22
ANALYSIS_DETECTOR_SSH_USER=root
ANALYSIS_DETECTOR_SSH_PASSWORD=123456789
ANALYSIS_DETECTOR_SSH_TIMEOUT=10s

# ## analysis · monitor
ANALYSIS_MONITOR_DATA_ID=0
ANALYSIS_MONITOR_TIMEOUT=10s
ANALYSIS_MONITOR_ACCESS_TOKEN=""
ANALYSIS_MONITOR_BK_MONITOR_BEAT=""
ANALYSIS_MONITOR_BK_MONITOR_ENDPOINT=127.0.0.1:9090

# ## analysis · logging
ANALYSIS_LOG_PATH=./logs/analysis.log

# --- probe (shard YAML follows same rules as redis; paths relative to this rc) ---

# ## probe · process and identity
PROBE_NAME=probe
PROBE_SERVICE_ID=""
PROBE_PID_FILE=./pids/probe.pid

# ## probe · reporter
PROBE_REPORTER_NAME=gse
PROBE_REPORTER_ENDPOINT=""
PROBE_REPORTER_DATA_ID=0
PROBE_REPORTER_CONN_TIMEOUT=5s

# ## probe · harvester · mysql
PROBE_MYSQL_SHARD_FILE=templates/snippets/probe_mysql_shard.yaml
PROBE_MYSQL_USER=root
PROBE_MYSQL_PASSWORD=root
PROBE_MYSQL_INTERVAL=20s
# mysql endpoints[0] (matches DbEndpointConfig)
PROBE_MYSQL_EP_PROTO=tcp
PROBE_MYSQL_EP_CLUSTER_TYPE=""
PROBE_MYSQL_EP_MACHINE_TYPE=""
PROBE_MYSQL_EP_ACCESS_LAYER=""
PROBE_MYSQL_EP_IP=127.0.0.1
PROBE_MYSQL_EP_PORTS=[1000-2000,20003]
PROBE_MYSQL_EP_ADMIN_PORTS=[]

# ## probe · harvester · redis
# 1/true: render harvester.redis (shard YAML, see PROBE_REDIS_SHARD_FILE); 0/false: omit redis section
PROBE_REDIS_SHARD_ENABLED=1
PROBE_REDIS_SHARD_FILE=templates/snippets/probe_redis_shard.yaml
PROBE_REDIS_PASSWORD=""
PROBE_REDIS_INTERVAL=20s
PROBE_REDIS_TIMEOUT=5s
# redis endpoints[0] (matches DbEndpointConfig)
PROBE_REDIS_EP_PROTO=tcp
PROBE_REDIS_EP_CLUSTER_TYPE=""
PROBE_REDIS_EP_MACHINE_TYPE=""
PROBE_REDIS_EP_ACCESS_LAYER=""
PROBE_REDIS_EP_IP=127.0.0.1
PROBE_REDIS_EP_PORTS=[3306,10000-12000]
PROBE_REDIS_EP_ADMIN_PORTS=[]

# ## probe · logging
PROBE_LOG_PATH=./logs/probe.log
